# Local: postgresql+asyncpg://user:password@localhost:5432/donutsmp
# Supabase (IPv4 pooler, session mode): postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/donutsmp
# Leave empty to auto-generate on first backend start (copy it into the mod config
# when the API is hosted; the mod runs on the player's PC, not on the server)
API_KEY=
# Keep on 127.0.0.1 when running behind the nginx reverse proxy.
# Ports are non-standard to avoid clashing with other apps on the server.
HOST=127.0.0.1
PORT=18700
DASHBOARD_PORT=18701
FRONTEND_DIST=../frontend/dist
# Prod uses Alembic migrations; leave 0
AUTO_CREATE_TABLES=0
# Same-origin through nginx needs no CORS; add the dashboard origin only if split
CORS_ORIGINS=https://tracker.example.com
# Per-player dashboard sign-in (codes come from /tracker link in-game)
SESSION_TTL_DAYS=7
LINK_CODE_TTL_SECONDS=300
SESSION_COOKIE_NAME=dtt_session
# Leave false on plain HTTP; Secure is auto-enabled when the request is https
COOKIE_SECURE=false
