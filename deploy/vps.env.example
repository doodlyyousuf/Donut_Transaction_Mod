# Copy this file to deploy/vps.env and fill in your details.
# deploy/vps.env is gitignored because it is machine-specific.

# SSH connection
VPS_HOST=203.0.113.10
VPS_USER=root
VPS_PORT=22
# Private key created for this deployment. Never commit it.
VPS_SSH_KEY=/root/.ssh/donutsmp_vps

# Public hostname the dashboard is served on.
# - IP-only, plain HTTP:  VPS_HOSTNAME=<the IP>, VPS_USE_TLS=0
# - With a domain + HTTPS: VPS_HOSTNAME=tracker.example.com, VPS_USE_TLS=1
VPS_HOSTNAME=203.0.113.10
VPS_USE_TLS=0

# Port the dashboard is served on when VPS_USE_TLS=0. A high, unusual port
# keeps the test instance off port 80 so it cannot disturb a live site that
# already owns that port. Ignored when VPS_USE_TLS=1 (nginx then uses 80/443).
VPS_FRONTEND_PORT=18701

# Required only when VPS_USE_TLS=1 (used by certbot for expiry notices).
LETSENCRYPT_EMAIL=

# Server-side paths and database naming
REMOTE_DIR=/opt/donutsmp-tracker
DB_NAME=donutsmp
DB_USER=donut
